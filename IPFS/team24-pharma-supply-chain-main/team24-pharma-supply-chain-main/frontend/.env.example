# Deployed contract address (set after running deploy.js)
REACT_APP_CONTRACT_ADDRESS=0x_your_contract_address_here

# Sepolia RPC URL for read-only calls
REACT_APP_RPC_URL=https://rpc.sepolia.org

# Pinata IPFS credentials (get from app.pinata.cloud)
REACT_APP_PINATA_API_KEY=your_pinata_api_key
REACT_APP_PINATA_SECRET_KEY=your_pinata_secret_key

# IPFS gateway URL
REACT_APP_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/