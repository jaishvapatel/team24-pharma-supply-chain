# ─── Blockchain ───────────────────────────────────────────────────────────────
PRIVATE_KEY=your_wallet_private_key_here
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Populated automatically by deploy.js, or set manually:
REACT_APP_CONTRACT_ADDRESS=0x...

# Sepolia RPC for read-only calls (no wallet needed)
REACT_APP_RPC_URL=https://rpc.sepolia.org

# ─── IPFS / Pinata ────────────────────────────────────────────────────────────
# Get keys at https://app.pinata.cloud/keys
REACT_APP_PINATA_API_KEY=your_pinata_api_key
REACT_APP_PINATA_SECRET_KEY=your_pinata_secret_key

# Optional: use a custom IPFS gateway
REACT_APP_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Optional: local Kubo / IPFS Desktop node (used when Pinata keys are absent)
REACT_APP_LOCAL_IPFS=http://localhost:5001
